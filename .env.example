# === LLM Provider ===
# LLM_BACKEND is the upstream URL the llm_proxy forwards to.
# LLM_API_KEY is injected by the proxy — Cowrie containers never see it.
# HP_MODEL    is the model used by the Cowrie honeypot instances.
# AGENT_MODEL is the model used by the analysis agent.
#
# For aiqu.ai (default):
#LLM_BACKEND=https://llm.aiqu.ai
#HP_MODEL=gpt-oss-120b
#AGENT_MODEL=nemotron-3-super
#LLM_API_KEY=your_aiqu_api_key
#
# For OpenAI:
#LLM_BACKEND=https://api.openai.com
#HP_MODEL=gpt-4.1-mini
#AGENT_MODEL=gpt-4.1-mini
#LLM_API_KEY=sk-...
#
# For Ollama on the host machine:
#LLM_BACKEND=http://host.docker.internal:11434
#HP_MODEL=qwen2.5:32b
#AGENT_MODEL=qwen2.5:32b
#LLM_API_KEY=
#
# For Together AI:
#LLM_BACKEND=https://api.together.xyz
#HP_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
#AGENT_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
#LLM_API_KEY=your_together_api_key

LLM_BACKEND=https://llm.aiqu.ai
HP_MODEL=gpt-oss-120b
AGENT_MODEL=nemotron-3-super
LLM_API_KEY=your_aiqu_api_key_here

# === API Keys ===
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# === Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# === Filter Gateway ===
MAX_CONN_RATE=10          # Max new connections per IP per minute
MAX_CONCURRENT=3          # Max concurrent sessions per IP
SILENT_DROP_TIMEOUT=30    # Seconds before dropping silent connections

# === Session Analyzer ===
LEARN_THRESHOLD=5         # Unique IPs before auto-learning a signature
BRUTE_FORCE_THRESHOLD=20  # Failed auths before banning
RAPID_DISCONNECT_SEC=5    # Sessions shorter than this are suspicious
SPIKE_WINDOW_MIN=10       # Sliding window for spike detection (minutes)
SPIKE_MULTIPLIER=5        # Alert if connections > Nx baseline

# === Blocklist ===
CONFIDENCE_MINIMUM=90     # AbuseIPDB confidence threshold
UPDATE_HOUR=3             # Hour (UTC) to refresh blocklist

# === Attack Theater Dashboard ===
# Set to a strong password to enable HTTP Basic Auth on the dashboard.
# Leave empty to disable auth (only safe when HOST=127.0.0.1 and port is not forwarded).
THEATER_PASSWORD=change-me

# === Decoy Database Credentials ===
# Generate unique passwords per deployment: openssl rand -base64 24
# These are the credentials shown to (and used by) attackers inside the honeypot.

# Hop 1 — MySQL (wordpress server)
# COWRIE_DB_ROOT_PASSWORD_HOP1: MySQL root password for the decoy DB container.
# COWRIE_DB_PASSWORD_HOP1:      wp_admin password — Cowrie's DB proxy connects with this.
COWRIE_DB_ROOT_PASSWORD_HOP1=change-me-unique-per-deployment
COWRIE_DB_PASSWORD_HOP1=change-me-unique-per-deployment

# Hop 2 — Postgres (database server)
# HONEYPOT_DB_PASSWORD is used for both the real Postgres container AND Cowrie's DB proxy.
# A single value keeps them in sync — no separate HOP2 password vars needed.
HONEYPOT_DB_PASSWORD=change-me-unique-per-deployment

# === Analysis Agent ===
# How often (seconds) the analysis agent polls theater.db for new sessions to analyse.
ANALYSIS_POLL_INTERVAL_SEC=300

# === GeoIP Database ===
# Place GeoLite2-City.mmdb in $LOG_DIR/theater/ (default: ./data/theater/).
# The attack theater picks it up automatically — no env var needed.
# Download free from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data

# === Log Directory ===
# All logs and databases are written here as regular files on the host.
# Default: ./data (relative to docker-compose file)
#LOG_DIR=/opt/honeypot/data
